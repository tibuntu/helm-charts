{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>tibuntu/renovate-presets"
  ],
  "ignorePaths": [],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the test image in chart CI values (registry/repository/tag block)",
      "managerFilePatterns": [
        "/charts/[^/]+/ci/[^/]+-values\\.yaml$/"
      ],
      "matchStrings": [
        "registry:\\s*(?<registry>[^\\s#]+)\\s*\\n\\s*repository:\\s*(?<depName>[^\\s#]+)(?:\\s*\\n\\s*[^\\n]*)*?\\s*\\n\\s*tag:\\s*[\"']?(?<currentValue>[^\"'\\s#]+)[\"']?"
      ],
      "datasourceTemplate": "docker",
      "registryUrlTemplate": "https://{{registry}}"
    },
    {
      "customType": "regex",
      "description": "Update the pinned busybox image in the chart test pods",
      "managerFilePatterns": [
        "/charts/[^/]+/templates/tests/[^/]+\\.yaml$/"
      ],
      "matchStrings": [
        "image:\\s*(?<depName>busybox):(?<currentValue>[^\\s\"']+)"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
